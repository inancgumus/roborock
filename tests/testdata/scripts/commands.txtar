stdin login.txt
exec roborock &
await 'Ready!'
vacuum clear

# Reading
exec roborock status show
stdout '^State: Charging$'
stdout '^Battery: 87%$'
stdout '^No errors$'
stdout '^Last clean: 0\.0 m² in 1 min$'
! stdout '[\[{]'
exec roborock quiet show
stdout '^On, from 22:00 to 07:00$'
exec roborock locks show
stdout '^Off$'
exec roborock lights show
stdout '^On$'

exec roborock rooms list
stdout '^  1  Kitchen$'
stdout '^  2  Bedroom$'
exec roborock offpeak show
stdout '^Off$'
exec roborock history list
stdout '^Cleaned 12 times, 50\.0 m² in 5 h 0 min$'
exec roborock clean estimate
stdout '^Time left: 1 h 5 min of 2 h 29 min$'
exec roborock parts show
stdout '^Main brush: 290 h left$'

# A setting can be read, changed and read again
exec roborock volume show
stdout '^30%$'
exec roborock volume set 40
stdout '^Done\.$'
vacuum await volume 40
exec roborock volume show
stdout '^40%$'

# Plain words and numbers turn into what the robot expects
exec roborock clean rooms 1,2
vacuum sent app_segment_clean '[{"segments": [1, 2], "repeat": 1}]'
exec roborock clean rooms 2 3
vacuum sent app_segment_clean '[{"segments": [2], "repeat": 3}]'
exec roborock quiet set 22:30 08:00
vacuum sent set_dnd_timer '[22, 30, 8, 0]'
exec roborock locks set on
vacuum sent set_child_lock_status '{"lock_status": 1}'
exec roborock lights set off
vacuum sent set_led_status '[0]'
exec roborock drying start
vacuum sent app_set_dryer_status '{"status": 1}'
exec roborock drying stop
vacuum sent app_set_dryer_status '{"status": 0}'
