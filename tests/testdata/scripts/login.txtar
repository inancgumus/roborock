# The first start asks for an email, has the cloud email a code and logs in with it
stdin login.txt
exec roborock &
await 'Logged in\.'
await 'Ready!'
await 'Serving Fakey'
cloud asked me@example.com
exec roborock status show
stdout "'battery': 87"

# The library's own logs stay out of the terminal
kill
! stdout 'MQTT'

-- login.txt --
me@example.com
123456
