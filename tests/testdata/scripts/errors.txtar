# Without a server, commands say how to start one
! exec roborock status show
stderr 'No server is running'
stderr 'Start one in another terminal with \./roborock\.py'

stdin login.txt
exec roborock &
await 'Ready!'
vacuum clear

# Bad input never reaches the robot
! exec roborock volume set 500
stderr 'use a number from 0 to 100'
! vacuum sent change_sound_volume
! exec roborock quiet set 25:00 08:00
stderr 'use HH:MM'
! exec roborock lights set maybe
stderr 'use on or off'
! exec roborock clean rooms one
stderr 'use numbers separated by commas'

# Unknown commands and areas
! exec roborock nope
stderr "unknown command 'nope'"
! exec roborock clean nope
stderr "unknown command 'nope'"

# A method this robot lacks is reported as an error
! exec roborock schedules summary
stderr 'does not support that command'

# A change the robot refuses is reported in plain words
! exec roborock obstacles dirt on
stderr 'The robot refused the change for now'

# A lost message is sent again
vacuum drop get_sound_volume 2
exec roborock volume show
stdout '30'

# A robot that stays silent is reported in plain words
vacuum drop get_sound_volume 5
! exec roborock volume show
stderr 'The robot did not answer'
! stderr 'RoborockException'

# The server says why it cannot check the robot
vacuum drop get_status 5
# After repeated silence the library restarts its connection, so the reason may be either
await 'Could not check the robot\. (The robot did not answer|The connection to the Roborock cloud dropped)'
